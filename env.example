# Copy these variables into your shell profile (.zshrc/.bashrc) or deployment environment.
# Telegram token generated by BotFather. Do not send this in Telegram chat.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user id allowed to use the bot.
TELEGRAM_ALLOWED_USER_ID=

# Root directory containing your local projects.
WORK_DIR=/Users/you/Developer

# Optional local persistence directory. Defaults to ./data.
DATA_DIR=./data
