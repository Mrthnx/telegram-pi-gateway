# Copy these variables into your shell profile (.zshrc/.bashrc) or deployment environment.
# Telegram token generated by BotFather. Do not send this in Telegram chat.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user id allowed to use the bot.
TELEGRAM_ALLOWED_USER_ID=

# Root directory containing your local projects.
WORK_DIR=/Users/you/Developer

# Optional local persistence directory. Defaults to ./data.
DATA_DIR=./data

# Optional. Model used by the gateway sessions, as "<provider>/<id>".
# Takes precedence over PI_MODEL / PI_PROVIDER inherited from the Pi harness.
TELEGRAM_PI_MODEL=

# Optional. Voice used for voice notes when the owner does not name one.
# macOS voice name, for example "Mónica" (es_ES) or "Paulina" (es_MX).
TELEGRAM_VOICE=

# Optional. Local neural speech engine (Piper). Path to a downloaded .onnx model.
# When a model is present, Piper is used instead of macOS "say".
# Default location: ~/.local/share/piper/*.onnx
# TELEGRAM_TTS_MODEL=/Users/you/.local/share/piper/es_ES-sharvard-medium.onnx

# Optional. Spoken language for transcription. Defaults to auto detection.
# TELEGRAM_STT_LANGUAGE=auto
