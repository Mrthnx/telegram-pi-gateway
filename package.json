{
  "name": "telegram-pi-gateway",
  "version": "0.3.0",
  "description": "Standalone Telegram gateway for local Pi coding-agent sessions: chat with Pi from Telegram, send images and voice notes, and get answers with media back.",
  "type": "module",
  "bin": {
    "telegram-pi-gateway": "bin/telegram-pi-gateway.mjs"
  },
  "license": "MIT",
  "author": "Mrthnx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrthnx/telegram-pi-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/Mrthnx/telegram-pi-gateway/issues"
  },
  "homepage": "https://github.com/Mrthnx/telegram-pi-gateway#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-sdk",
    "pi-gateway",
    "telegram",
    "telegram-bot",
    "bun",
    "coding-agent",
    "media",
    "voice-notes"
  ],
  "files": [
    "bin",
    "src",
    "Dockerfile",
    ".dockerignore",
    "env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "grammy": "latest",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
